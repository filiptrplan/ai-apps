{
  "name": "ai-apps",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "dev": "vite",
    "dev:server": "node --watch-path=server --env-file-if-exists=.env server/index.js",
    "test": "node --test mcp/*.test.mjs german/*.test.mjs moped-route/*.test.mjs && node server/runTests.mjs",
    "test:server": "node server/runTests.mjs",
    "db:migrate": "docker compose -f deploy/compose.dev.yaml run --rm --user \"$(id -u):$(id -g)\" migrate --wait up"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pdf-lib": "^1.17.1",
    "postgres": "^4.0.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "dbmate": "^2.37.0",
    "esbuild": "^0.24.0",
    "vite": "^6.4.3"
  }
}
